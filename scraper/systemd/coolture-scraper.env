# Copied to /etc/coolture-scraper.env. The next run reads a change; nothing needs restarting.

# The branch the computer runs, the one deployed to SCRAPER_ENV.
SCRAPER_BRANCH=main
SCRAPER_ENV=dev
# A profile in /var/lib/coolture-scraper/.aws/config that assumes the runner role (scraper/README.md).
AWS_PROFILE=coolture-scraper
